        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (rate(booking_events_total{status=\"failure\"}[1m]))",
          "legendFormat": "Failure: {{reason}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Booking Success vs Failure Rate Over Time",
      "type": "timeseries"
    },
