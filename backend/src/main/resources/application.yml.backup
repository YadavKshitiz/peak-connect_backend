server:
  port: 8080

spring:
  profiles:
    active: dev
  datasource:
    url: ${DB_URL}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.PostgreSQLDialect

jwt:
  secret: ${JWT_SECRET}
  expiration-ms: 86400000
openweathermap:
  api-key: ${OPENWEATHER_API_KEY:default_key}
  url: ${OPENWEATHER_URL:https://api.openweathermap.org/data/2.5/weather}

scheduler:
  weather-refresh-interval-ms: 1800000
  auto-cancel-interval-ms: 300000

booking:
  payment-timeout-minutes: 15

payment:
  deposit-percentage: 0.2

razorpay:
  key-id: ${RAZORPAY_KEY_ID:dummy_key_id}
  key-secret: ${RAZORPAY_KEY_SECRET:dummy_key_secret}

management:
  endpoints:
    web:
      exposure:
        include: health,metrics
  endpoint:
    health:
      show-details: always

resilience4j.circuitbreaker:
  instances:
    weatherApi:
      slidingWindowSize: 10
      failureRateThreshold: 50
      waitDurationInOpenState: 10s
      permittedNumberOfCallsInHalfOpenState: 3
    osrmApi:
      slidingWindowSize: 10
      failureRateThreshold: 50
      waitDurationInOpenState: 10s
      permittedNumberOfCallsInHalfOpenState: 3
    paymentApi:
      slidingWindowSize: 10
      failureRateThreshold: 50
      waitDurationInOpenState: 10s
      permittedNumberOfCallsInHalfOpenState: 3

resilience4j.retry:
  instances:
    weatherApi:
      maxAttempts: 3
      waitDuration: 500ms
    osrmApi:
      maxAttempts: 3
      waitDuration: 500ms
    paymentApi:
      maxAttempts: 3
      waitDuration: 500ms
