# ==============================================================================
# PeakConnect Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real credentials.
# NEVER commit your actual .env file or production secrets to source control.
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/peakconnect
DB_USERNAME=peakconnect_user
DB_PASSWORD=change-me-db-password

# Authentication (JWT)
JWT_SECRET=change-me-to-a-secure-256-bit-secret-key-for-jwt

# Redis Cache (Local: localhost:6379, SSL=false | Cloud: Upstash, SSL=true)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# External APIs
# OpenWeatherMap (Free Tier)
OPENWEATHER_API_KEY=change-me-openweather-api-key

# OSRM Driving Route Engine (Public Demo Server)
OSRM_BASE_URL=https://router.project-osrm.org

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=change-me-razorpay-key-id
RAZORPAY_KEY_SECRET=change-me-razorpay-key-secret
